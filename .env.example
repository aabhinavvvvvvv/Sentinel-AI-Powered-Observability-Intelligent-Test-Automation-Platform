# Sentinel environment configuration — TEMPLATE.
# Copy to `.env` (which is git-ignored) and adjust:   cp .env.example .env
# Never put real production secrets in this file; it is committed to Git.

# --- PostgreSQL container (read by docker-compose.yml) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sentinel
# Host port the container is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# --- Backend API (read by backend/src/config.ts) ---
# One of: development | test | production
NODE_ENV=development
PORT=3000
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://sentinel:change-me-local-only@localhost:5432/sentinel
# Separate database used by `npm test` (created automatically; its tables get wiped).
TEST_DATABASE_URL=postgres://sentinel:change-me-local-only@localhost:5432/sentinel_test
# How long GET /healthz waits for the database before reporting it as down.
HEALTHCHECK_DB_TIMEOUT_MS=2000

{
  "name": "@sentinel/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel core backend: application API (and, later, background workers).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts | pino-pretty",
    "dev:worker": "tsx watch --env-file-if-exists=../.env src/worker.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "start:worker": "node --env-file-if-exists=../.env dist/worker.js",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate-cli.ts",
    "replay": "tsx --env-file-if-exists=../.env src/testing/replay-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bullmq": "^6.7.3",
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
